# =============================================================================
# Copie ce fichier en `.env` et remplis les valeurs.
# `.env` est gitignoré : les secrets ne doivent JAMAIS être commités.
# =============================================================================

# --- Supabase (Project Settings > API) --------------------------------------
# Ces deux valeurs sont publiques (la clé anon est protégée par les règles RLS).
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Google Fit (console.cloud.google.com) ----------------------------------
# Le Client ID est public (il apparaît dans l'URL d'autorisation).
# Le Client SECRET ne va PAS ici : il se configure côté Supabase Edge Functions
# (voir docs/SETUP.md), jamais dans le bundle frontend.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# --- Fitbit (dev.fitbit.com) ------------------------------------------------
# Idem : Client ID public, Client Secret côté Edge Functions uniquement.
VITE_FITBIT_CLIENT_ID=XXXXXX

# --- URL publique de l'app (utilisée pour construire les redirect_uri) ------
# En local, laisse vide : le code retombe sur window.location.origin.
VITE_APP_URL=
